#version 430 core

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in; // 1x pro zeile

struct tile
{
  uint heights[4];
};

layout(binding = 0, std430) buffer data 
{
  tile tiles[];
};

uniform layout(r8) image2D texture;

uniform uint width;
uniform uint hashValue;
uniform vec3 sunDir;
uniform bool meltSnow;
uniform bool evaporateWater;
uniform bool rain;

uint height_from_idx(uint idx)
{
  uint mask = 0xFFFF;
  uint height = 0;

  for (uint i = 0; i < 4; i++)
  {
    height += tiles[idx].heights[i] & mask;
    height += tiles[idx].heights[i] >> 16;
  }

  return height;
}

const uint phi = 0x61C88647;

uint pcg_hash(uint x)
{
  uint state = x * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

uint hash(uint x, uint y, uint v)
{
  return pcg_hash(((x * phi + y) * phi + v) * phi);
}

float interpolate_temperature(uvec2 pos, uint tile_idx)
{
  const ivec2 maxTexWidth = ivec2(width / 4 - 1);

  vec2 fTexPos = max(vec2(pos) / vec2(4.0) - vec2(0.5), vec2(0, 0));
  ivec2 texPos = ivec2(fTexPos);

  float tSelf = imageLoad(texture, texPos).x;
  float tRight = imageLoad(texture, min(texPos + ivec2(1, 0), maxTexWidth)).x;
  float tBottom = imageLoad(texture, min(texPos + ivec2(0, 1), maxTexWidth)).x;
  float tBottomRight = imageLoad(texture, min(texPos + ivec2(1, 1), maxTexWidth)).x;
  
  vec2 fac = mod(fTexPos, 1.0);
  
  float top = mix(tSelf, tRight, fac.x);
  float bottom = mix(tBottom, tBottomRight, fac.x);
  float total = mix(top, bottom, fac.y);

  return total;
}

void main()
{
  const uint mask = 0xFFFF;
  uint y = gl_GlobalInvocationID.x;
  uint offset = y * width;

  for (uint x = 0; x < width; x++)
  {    
    uint i = offset + x;

    tile currentTile = tiles[i];
    uint waterHeight = currentTile.heights[0] >> 16;
    uint snowHeight = currentTile.heights[0] & mask;

    if (meltSnow)
    {
      if (snowHeight > 0)
      {
        uint meltAmount = max(uint(snowHeight * 0.02), 1); // max snowheight = 100

        uint loVal = ~meltAmount + 1;
        uint hiVal = (meltAmount - 1) << 16;
        uint val = hiVal | (loVal & mask);
        atomicAdd(tiles[i].heights[0], val);
      }
    }

    if (evaporateWater)
    {
      if (waterHeight > 0)
      {
        uint val = (~1 + 1) << 16;
        atomicAdd(tiles[i].heights[0], val);
      }
    }
    
    const float minTemp = -7;
    const float maxTemp = 23;
    const float maxSunTemp = 8 * 2.2;

    float temp = interpolate_temperature(uvec2(x, y), i) * (maxTemp + maxSunTemp) + minTemp;

    if (rain)
    {
      uint rand = hash(x, y, hashValue);

      if ((rand & 3) <= 1)
      {
        uint addVal = rand & 4;

        if (temp > 0)
          atomicAdd(tiles[i].heights[0], addVal << 16);
        else
          atomicAdd(tiles[i].heights[0], addVal);
      }
    }
    
    if (!meltSnow && !evaporateWater && temp > 0)
    {      
      if (snowHeight > 0)
      {
        uint meltAmount = 1;

        if (temp > 10)
          meltAmount = 3;
        if (temp > 3)
          meltAmount = 2;
        
        meltAmount = clamp(meltAmount, 0, snowHeight); // todo make this pretty

        uint loVal = ~meltAmount + 1;
        uint hiVal = (meltAmount - 1) << 16;
        uint val = hiVal | (loVal & mask);
        atomicAdd(tiles[i].heights[0], val);
      }
      else if (waterHeight > 0)
      {
        uint evaporation = 1;

        if (temp > 20)
          evaporation = 2;
        //if (temp > 15)
        //  evaporation = 2;

        evaporation = clamp(evaporation, 0, waterHeight); // todo make this pretty

        uint val = (~evaporation + 1) << 16;
        atomicAdd(tiles[i].heights[0], val);
      }
    }
  }
}
