#version 430 core

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in; // once per texture row

struct tile
{
  uint heights[4];
};

layout(binding = 0, std430) buffer data 
{
  tile tiles[];
};

uniform layout(r8) image2D texture;
uniform layout(rgba32f, binding = 1) image2D windTex; // vel.x vel.y height, air density

uniform float seasonTempFac;
uniform float lerpFactor;
uniform uint width;
uniform uint textureWidth;
uniform vec3 sunDir;

uint height_from_idx(uint idx)
{
  uint mask = 0xFFFF;
  uint height = 0;

  for (uint i = 0; i < 4; i++)
  {
    height += tiles[idx].heights[i] & mask;
    height += tiles[idx].heights[i] >> 16;
  }

  return height;
}

void main()
{
  const uint y = gl_GlobalInvocationID.x;

  for (uint x = 0; x < textureWidth; x++)
  {
    ivec2 texCoord = ivec2(x, y);

    // TODO: wind temp

    // sample height & normals for average
    uvec2 samplePos = texCoord * uvec2(4, 4);// uvec2(8, 8);
    uvec2 samplePosTop = samplePos + uvec2(2, 0);//uvec2(4, 2);
    uvec2 samplePosRight = samplePos + uvec2(3, 2);//uvec2(6, 4);
    uvec2 samplePosBottom = samplePos + uvec2(2, 3);//uvec2(4, 6);
    uvec2 samplePosLeft = samplePos + uvec2(0, 2);//uvec2(2, 4);

    uint heightTop = height_from_idx(samplePosTop.y * width + samplePosTop.x);
    uint heightRight = height_from_idx(samplePosRight.y * width + samplePosRight.x);
    uint heightBottom = height_from_idx(samplePosBottom.y * width + samplePosBottom.x);
    uint heightLeft = height_from_idx(samplePosLeft.y * width + samplePosLeft.x);

    uint avgHeight = (heightTop + heightRight + heightBottom + heightLeft) / 4;

    float yDiff = (float(heightTop) - float(heightBottom)) * 0.5; // is this an acceptable approximation
    float xDiff = (float(heightRight) - float(heightLeft)) * 0.5;
    vec3 avgNorm = normalize(vec3(xDiff, yDiff, 100));

    // calc temp
    const float winterMinTemp = -7;
    const float summerMinTemp = -3;
    const float winterMaxTemp = 16;
    const float summerMaxTemp = 20;
    const float maxSunTemp = 8 * 2.2;
    float sunTemp = 8 * (seasonTempFac + 1.2);
    float tempFac = (seasonTempFac + 1) * 0.5;

    float currentMinTemp = mix(winterMinTemp, summerMinTemp, tempFac);
    float currentMaxTemp = mix(winterMaxTemp, summerMaxTemp, tempFac);

    const uint maxHeight = 15000;
    float height = clamp(float(avgHeight) - 13000, float(0), float(maxHeight));

    float temp = mix(currentMinTemp, currentMaxTemp, 1 - height * (1.0 / maxHeight));
    float sunAllignment = dot(avgNorm, sunDir);

    if (sunAllignment > 0)
      temp += sunAllignment * sunTemp;

    float scaledTemp = (temp + winterMinTemp) / (summerMaxTemp + maxSunTemp);

    // mix with last temp
    float lastTemp = imageLoad(texture, texCoord).x;
    scaledTemp = mix(scaledTemp, lastTemp, lerpFactor);

    // set new temp
    imageStore(texture, texCoord, vec4(scaledTemp, 0, 0, 0));

    vec4 wind = imageLoad(windTex, texCoord);
    wind.w = mix(temp - 7, wind.w, lerpFactor);
    imageStore(windTex, texCoord, wind);
  }
}
